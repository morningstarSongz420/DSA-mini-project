import java.util.Scanner;

public class CampusServiceCentre {
    static Queue waitingQueue = new Queue(20);          // Static array-based queue
    static LinkedList serviceRecords = new LinkedList(); // Singly linked list
    static int[] serviceTimes = new int[100];            // Array for statistics
    static int serviceCount = 0;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int choice;

        do {
            System.out.println("========================================");
            System.out.println("CAMPUS SERVICE CENTRE");
            System.out.println("========================================");
            System.out.println("1. Add student to waiting queue");
            System.out.println("2. Serve next student (remove from queue)");
            System.out.println("3. Display waiting students");
            System.out.println("4. Add student service record");
            System.out.println("5. Display student service records");
            System.out.println("6. Search for student record");
            System.out.println("7. Remove student record");
            System.out.println("8. Display daily statistics");
            System.out.println("9. Sort service times");
            System.out.println("10. Run sorting experiment");
            System.out.println("11. Exit");
            System.out.print("Select option: ");
            choice = sc.nextInt();

            switch(choice) {
                case 1: // Queue — enqueue
                    System.out.print("Enter name: ");
                    String name = sc.next();
                    System.out.print("Enter service type: ");
                    String type = sc.next();
                    System.out.print("Enter service time: ");
                    int time = sc.nextInt();
                    waitingQueue.enqueue(new Student(1000+serviceCount, name, type, time));
                    break;

                case 2: // Queue — dequeue
                    Student served = waitingQueue.dequeue();
                    if (served != null) {
                        serviceTimes[serviceCount++] = served.serviceTime;
                        System.out.println("Served: " + served);
                    }
                    break;

                case 3: // Queue — display
                    waitingQueue.displayQueue();
                    break;

                case 4: // Linked List — insert
                    serviceRecords.insertAtEnd(new Student(2000+serviceCount, "Demo", "Fees", 7));
                    break;

                case 5: // Linked List — display
                    serviceRecords.displayStudents();
                    break;

                case 6: // Linked List — search
                    System.out.print("Enter student number: ");
                    int sn = sc.nextInt();
                    Student found = serviceRecords.searchStudent(sn);
                    System.out.println(found != null ? found : "Not found");
                    break;

                case 7: // Linked List — delete
                    System.out.print("Enter student number to delete: ");
                    int del = sc.nextInt();
                    serviceRecords.deleteStudent(del);
                    break;

                case 8: // Array statistics
                    Statistics.dailyStatistics(serviceTimes, serviceCount);
                    break;

                case 9: // Sorting
                    Sorting.selectionSort(serviceTimes, serviceCount);
                    System.out.println("Service times sorted.");
                    break;

                case 10: // Sorting experiment
                    Experiment.run();
                    break;
            }
        } while(choice != 11);
    }
}
